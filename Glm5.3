-- SECTION 19 : REMOTE BURST -- CORRIGE: end manquant dans version originale
-- =========================================================================
local function RemoteBurst(remotes, argsList)
    local executed  = 0
    local perRemote = REMOTE_BURST_WINDOW / math.max(1, math.min(#remotes, REMOTE_BURST_COUNT))
    for i = 1, math.min(#remotes, REMOTE_BURST_COUNT) do
        if killed then break end
        local remote = remotes[i]
        pcall(function()
            local args = argsList[i] or {}
            if remote:IsA("RemoteEvent") then
                remote:FireServer(table.unpack(args))
            elseif remote:IsA("RemoteFunction") then
                remote:InvokeServer(table.unpack(args))
            end
            executed                   += 1
            sessionStats.remotesTested += 1
        end)
        task.wait(perRemote)
    end
    Log("Burst: " .. executed .. " remotes en " .. REMOTE_BURST_WINDOW .. "s", Color3.fromRGB(255, 200, 50))
end

