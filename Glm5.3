local function CreateLabel(parent, text, height, isTitle)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Size           = UDim2.new(1, 0, 0, height)
    l.Font           = isTitle and Enum.Font.GothamBold or Enum.Font.Gotham
    l.Text           = text
    l.TextColor3     = isTitle and Color3.fromRGB(187, 134, 252) or Color3.fromRGB(200, 200, 200)
    l.TextSize       = isTitle and 13 or 10
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextWrapped    = true
    l.Parent         = parent
    return l
end

local function CreateInput(parent, placeholder, height, multiline)
    local tb = Instance.new("TextBox")
    tb.Size             = UDim2.new(1, 0, 0, height)
    tb.BackgroundColor3 = Color3.fromRGB(21, 21, 27)
    tb.Font             = Enum.Font.Gotham
    tb.PlaceholderText  = placeholder
    tb.Text             = ""
    tb.TextColor3       = Color3.fromRGB(255, 255, 255)
    tb.TextSize         = 10
    tb.TextWrapped      = true
    tb.MultiLine        = multiline or false
    tb.ClearTextOnFocus = false
    tb.Parent           = parent
    Instance.new("UICorner", tb).CornerRadius = UDim.new(0, 6)
    return tb
end

local function CreateButton(parent, text, color, height)
    local b = Instance.new("TextButton")
    b.Size             = UDim2.new(1, 0, 0, height or 30)
    b.BackgroundColor3 = color or Color3.fromRGB(187, 134, 252)
    b.Font             = Enum.Font.GothamBold
    b.Text             = text
    b.TextColor3       = Color3.fromRGB(13, 13, 17)
    b.TextSize         = 11
    b.Parent           = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    return b
end

