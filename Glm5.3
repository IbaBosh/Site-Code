-- =========================================================================
-- SECTION 28 : BOUCLE PRINCIPALE AUTONOME (multi-objectifs + scheduler)
-- =========================================================================
local function RunAutonomy()
    if running then return end

    local apiKey      = KeyInput.Text:match("^%s*(.-)%s*$") or ""
    local rawGoal     = PromptInput.Text:match("^%s*(.-)%s*$") or ""
    local jailbreak   = JailbreakInput.Text:match("^%s*(.-)%s*$") or ""
    local durationMin = tonumber(DurationInput.Text) or 0

    if #apiKey < 8 then
        Log("ERREUR: Cle API manquante.", Color3.fromRGB(255, 75, 75))
        return
    end
    if #rawGoal < 3 then
        Log("ERREUR: Objectif vide.", Color3.fromRGB(255, 75, 75))
        return
    end
    if #jailbreak < 10 then jailbreak = DEFAULT_JAILBREAK end

    -- Multi-objectifs : split par virgule, priorite ordre
    local goals = {}
    for g in rawGoal:gmatch("[^,]+") do
        local trimmed = g:match("^%s*(.-)%s*$")
        if #trimmed > 0 then table.insert(goals, trimmed) end
    end
    if #goals == 0 then goals = {rawGoal} end
    local userGoal = table.concat(goals, " + ")

    SaveKey(apiKey)
    running = true
    StartAutoBtn.Text             = "IA EN COURS..."
    StartAutoBtn.BackgroundColor3 = Color3.fromRGB(65, 65, 65)
    sessionStats.startTime = os.time()
    SetBar(0)

    -- Scheduler : arret auto apres N minutes si specifie
    if durationMin > 0 then
        task.delay(durationMin * 60, function()
            if running then
                Log("Duree limite atteinte (" .. durationMin .. " min)", Color3.fromRGB(255, 150, 50))
                killed = true
            end
        end)
        Log("Scheduler: arret dans " .. durationMin .. " min", Color3.fromRGB(3, 218, 198))
    end

    task.spawn(function()
        SetupAntiKick()

        -- Chargement ou construction du graphe
        local graphData
        if not graphBuilt then
            graphData = BuildKnowledgeGraph(apiKey, userGoal)
        else
            if not currentGameFolder then
                currentGameFolder = MEMORY_BASE .. "/" .. GetGameFolderName()
            end
            graphData = LoadJSON(currentGameFolder .. "/graph.json")
            if not graphData then
                graphData = BuildKnowledgeGraph(apiKey, userGoal)
            else
                Log("Graphe existant charge (" .. #graphData.nodes .. " noeuds)", Color3.fromRGB(3, 218, 198))
            end
        end

        if not graphData then
            Log("ERREUR: Impossible de construire le graphe.", Color3.fromRGB(255, 75, 75))
            running = false
            killed  = false
            StartAutoBtn.Text             = "LANCER L'AUTONOMIE"
            StartAutoBtn.BackgroundColor3 = Color3.fromRGB(187, 134, 252)
            return
        end

        local lastCode, lastResult = nil, nil

        for cycle = 1, MAX_CYCLES do
            if killed or not running then break end
            LogSection("CYCLE " .. cycle .. "/" .. MAX_CYCLES, Color3.fromRGB(187, 134, 252))
            sessionStats.cycles = cycle
            SetBar(10 + (cycle - 1) * (80 / MAX_CYCLES))

            -- Construction du prompt master
            local graphNodesStr = ""
            local maxN = math.min(#graphData.nodes, 100)
            for i = 1, maxN do
                graphNodesStr ..= "[" .. graphData.nodes[i].type .. "] " .. tostring(graphData.nodes[i].label) .. "\n"
            end
            local spyStr  = ""
            local spyList = graphData.spyData or {}
            for i = 1, math.min(#spyList, 20) do
                spyStr ..= tostring(spyList[i].path) .. " | " .. tostring(spyList[i].method or "FIRE") .. "\n"
            end
            local webStr = table.concat(graphData.webIntel or {}, "\n"):sub(1, 3000)

            local masterPrompt = string.format([[
%s

TU ES NEXUS AI V6, AGENT AUTONOME D'EXPLOITATION ROBLOX.

JEU: %s (PlaceId: %s)
OBJECTIF(S): %s
CYCLE: %d/%d

KNOWLEDGE GRAPH (%d noeuds):
%s
APPELS REMOTES ESPIONNES:
%s
INTEL WEB VULNERABILITES:
%s
DERNIER CODE (cycle precedent):
%s
DERNIER RESULTAT: %s
ANTI-CHEAT DETECTE: %s

CONSIGNES OBLIGATOIRES:
- Reponds en francais.
- Genere un script Luau COMPLET qui exploite les failles identifiees dans le graphe.
- Utilise les REMOTE_MODIFIABLE. N'attaque jamais les REMOTE_PROTEGE.
- Mesure les degats avant/apres si applicable. Boucle jusqu'a l'objectif.
- Si ECHEC precedent: change totalement de strategie (autre remote, autres args, autre approche).
- Si anti-cheat: sois furtif (tweens, delays aleatoires, pas de teleport snap).
- Termine ta reponse par CONFIRME: <ce qui a marche> ou ECHEC: <raison precise>.
- Code entre <CODE> et </CODE> uniquement.
]], jailbreak,
    game.Name, tostring(game.PlaceId), userGoal, cycle, MAX_CYCLES,
    #graphData.nodes, graphNodesStr, spyStr, webStr,
    tostring(lastCode or "aucun"):sub(1, 5000),
    tostring(lastResult or "aucun"):sub(1, 1500),
    antiCheatDetected and "OUI - mode furtif obligatoire" or "NON - liberte totale")

            -- Appel GLM 5.3
            Log("Appel GLM 5.3 cycle " .. cycle .. "...", Color3.fromRGB(145, 205, 255))
            local aiResponse = CallGLM(masterPrompt, apiKey)
            if killed or not running then break end

            if not aiResponse then
                Log("GLM echec cycle " .. cycle, Color3.fromRGB(255, 75, 75))
                lastResult = "ECHEC: GLM non disponible"
                task.wait(2)
                continue
            end

            -- Affichage reponse IA en logs
            for line in aiResponse:gmatch("[^\n]+") do
                local l = line:match("^%s*(.-)%s*$")
                if #l > 1 and not l:find("^<CODE>") and not l:find("^</CODE>") then
                    Log("  " .. l:sub(1, 120), Color3.fromRGB(145, 205, 255))
                end
            end

            -- Extraction du code
            local blocks = ExtractCodeBlocks(aiResponse)
            if #blocks == 0 then
                Log("Aucun bloc code au cycle " .. cycle, Color3.fromRGB(255, 75, 75))
                lastResult = "ECHEC: aucun bloc <CODE> dans la reponse"
                task.wait(2)
                continue
            end

            local aiCode = blocks[1]
            lastCode = aiCode

            -- Validation syntaxe
            local fn, syntaxErr = loadstring(aiCode)
            if not fn then
                Log("Syntaxe invalide: " .. tostring(syntaxErr):sub(1, 80), Color3.fromRGB(255, 75, 75))
                lastResult = "ECHEC: syntaxe - " .. tostring(syntaxErr):sub(1, 80)
                task.wait(2)
                continue
            end
            Log("Syntaxe OK (" .. #aiCode .. " chars)", Color3.fromRGB(75, 255, 75))

            -- Sauvegarde (remplace l'ancien automatiquement)
            SaveScriptToFolder(aiCode)

            -- Execution
            Log("Execution script cycle " .. cycle .. "...", Color3.fromRGB(255, 225, 50))
            local ok, execErr, outputs = ExecuteCode(aiCode)

            if ok then
                Log("Execution OK", Color3.fromRGB(75, 255, 75))
                for _, out in ipairs(outputs) do
                    Log("  OUT: " .. tostring(out):sub(1, 150), Color3.fromRGB(115, 250, 170))
                end
                lastResult = "OK - " .. table.concat(outputs, " | "):sub(1, 500)
                sessionStats.remoteSuccesses += 1
                -- Kill aura si l'objectif le demande
                local goalLower = userGoal:lower()
                if goalLower:find("kill") or goalLower:find("attack") or goalLower:find("aura") then
                    Log("Kill aura active automatiquement", Color3.fromRGB(255, 200, 50))
                    KillAuraLoop()
                end
            else
                Log("Crash: " .. tostring(execErr):sub(1, 100), Color3.fromRGB(255, 75, 75))
                lastResult = "ECHEC: crash - " .. tostring(execErr):sub(1, 200)
            end

            -- Verification confirmation IA
            if aiResponse:find("CONFIRME:") or aiResponse:find("CONFIRME :") then
                Log("SUCCES CONFIRME PAR L'IA", Color3.fromRGB(75, 255, 75))
                SetBar(100)
                break
            end

            task.wait(2)
        end

        -- Self-improvement si echec persistant
        if lastCode and lastResult and lastResult:find("ECHEC") then
            LogSection("SELF-IMPROVEMENT", Color3.fromRGB(255, 175, 50))
            local improved = SelfImprove(apiKey, jailbreak, lastCode, lastResult, graphData, userGoal)
            if improved then
                local fn2, err2 = loadstring(improved)
                if fn2 then
                    Log("Version amelioree: " .. #improved .. " chars", Color3.fromRGB(3, 218, 198))
                    SaveScriptToFolder(improved)
                    local ok2, runErr2 = pcall(fn2)
                    if ok2 then
                        Log("Version amelioree executee OK", Color3.fromRGB(75, 255, 75))
                    else
                        Log("Version amelioree crash: " .. tostring(runErr2):sub(1, 80), Color3.fromRGB(255, 75, 75))
                    end
                else
                    Log("Self-improve syntaxe: " .. tostring(err2):sub(1, 60), Color3.fromRGB(255, 75, 75))
                end
            else
                Log("Self-improve: pas de code retourne", Color3.fromRGB(255, 150, 50))
            end
        end

        -- Sauvegarde metriques de session persistantes (append, pas overwrite)
        pcall(function()
            local statsPath = "nexus_stats.json"
            local existing  = LoadJSON(statsPath) or {}
            if type(existing) ~= "table" then existing = {} end
            table.insert(existing, {
                date            = os.date("%Y-%m-%d %H:%M:%S"),
                game            = game.Name,
                placeId         = tostring(game.PlaceId),
                cycles          = sessionStats.cycles,
                kills           = sessionStats.kills,
                dps             = sessionStats.dps,
                remotesTested   = sessionStats.remotesTested,
                remoteSuccesses = sessionStats.remoteSuccesses,
                duration        = os.time() - sessionStats.startTime
            })
            SaveJSON(statsPath, existing)
            Log("Session #" .. #existing .. " archivee dans nexus_stats.json", Color3.fromRGB(3, 218, 198))
        end)

        LogSection("SESSION TERMINEE", Color3.fromRGB(255, 255, 255))
        Log(string.format("Cycles: %d | Kills: %d | Remotes: %d | DPS: %.1f",
            sessionStats.cycles, sessionStats.kills,
            sessionStats.remotesTested, sessionStats.dps),
            Color3.fromRGB(3, 218, 198))

        running = false
        killed  = false
        StartAutoBtn.Text             = "LANCER L'AUTONOMIE"
        StartAutoBtn.BackgroundColor3 = Color3.fromRGB(187, 134, 252)
        SetBar(0)
    end)
end

