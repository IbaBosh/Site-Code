-- SECTION 32 : BACKDOOR SCANNER
-- =========================================================================
local function ScanBackdoors()
    local found    = {}
    local keywords = {"getfenv","loadstring","http_request","syn.request","exploit","backdoor","bypass","execute"}
    local svcList  = {ReplicatedStorage, StarterGui, StarterPlayer, Workspace}
    if ServerScriptService then table.insert(svcList, ServerScriptService) end
    if ServerStorage       then table.insert(svcList, ServerStorage)       end
    for _, svc in ipairs(svcList) do
        if svc then
            pcall(function()
                for _, v in pairs(svc:GetDescendants()) do
                    if v:IsA("ModuleScript") or v:IsA("LocalScript") or v:IsA("Script") then
                        local ln = v.Name:lower()
                        for _, kw in ipairs(keywords) do
                            if ln:find(kw, 1, true) then
                                table.insert(found, {name = v.Name, path = v:GetFullName(), keyword = kw})
                                Log("BACKDOOR? [" .. kw .. "] " .. v.Name, Color3.fromRGB(255, 150, 50))
                                break
                            end
                        end
                    end
                end
            end)
        end
    end
    local col = #found > 0 and Color3.fromRGB(255, 150, 50) or Color3.fromRGB(75, 255, 75)
    Log("Backdoor scan: " .. #found .. " suspects", col)
    return found
end

