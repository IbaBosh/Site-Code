local function ExtractCodeBlocks(aiResponse)
    local blocks = {}
    for block in aiResponse:gmatch("<CODE>(.-)</CODE>") do
        table.insert(blocks, block)
    end
    for block in aiResponse:gmatch("```lua%s*(.-)```") do
        table.insert(blocks, block)
    end
    for block in aiResponse:gmatch("```luau%s*(.-)```") do
        table.insert(blocks, block)
    end
    for block in aiResponse:gmatch("```%s*(.-)```") do
        table.insert(blocks, block)
    end
    return blocks
end

