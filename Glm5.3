-- SECTION 35 : ITEM/SHOP ANALYZER (remotes buy/purchase/equip)
-- =========================================================================
local function AnalyzeShopRemotes()
    local shopKeywords = {"buy","shop","purchase","equip","sell","item","store","trade"}
    local shopRemotes  = {}
    pcall(function()
        for _, v in pairs(ReplicatedStorage:GetDescendants()) do
            if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
                local ln = v.Name:lower()
                for _, kw in ipairs(shopKeywords) do
                    if ln:find(kw, 1, true) then
                        table.insert(shopRemotes, v)
                        Log("Shop remote: " .. v:GetFullName(), Color3.fromRGB(255, 200, 50))
                        break
                    end
                end
            end
        end
    end)
    Log("Shop: " .. #shopRemotes .. " remotes detectes", Color3.fromRGB(3, 218, 198))
    if #shopRemotes > 0 then
        ShowToast("Shop analyzer: " .. #shopRemotes .. " remotes trouves", Color3.fromRGB(255, 200, 50))
    end
    -- Test avec args hors-limites (0, -1, 999999, index nul, vide)
    for _, remote in ipairs(shopRemotes) do
        if killed then break end
        for _, args in ipairs({{0}, {-1}, {999999}, {"test"}, {}}) do
            pcall(function()
                if remote:IsA("RemoteEvent") then
                    remote:FireServer(table.unpack(args))
                elseif remote:IsA("RemoteFunction") then
                    remote:InvokeServer(table.unpack(args))
                end
            end)
            task.wait(0.2)
        end
        Log("Shop test: " .. remote.Name .. " teste (5 args)", Color3.fromRGB(145, 205, 255))
    end
    return shopRemotes
end

