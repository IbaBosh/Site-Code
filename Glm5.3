local GraphFrame = tabFrames["GRAPHE"]

local function UpdateGraphTab(graphData)
    for _, child in ipairs(GraphFrame:GetChildren()) do
        if not child:IsA("UIListLayout") then child:Destroy() end
    end
    if not graphData then
        CreateLabel(GraphFrame, "Aucun graphe. Clique COMMENCER LE GRAPHIQUE.", 14)
        return
    end
    local nodes = graphData.nodes or {}
    local remMod, acCount = 0, 0
    for _, node in ipairs(nodes) do
        if node.type == "REMOTE_MODIFIABLE" then remMod  += 1 end
        if node.type == "ANTI_CHEAT"        then acCount += 1 end
    end
    CreateLabel(GraphFrame, "KNOWLEDGE GRAPH", 16, true)
    CreateLabel(GraphFrame, "Jeu: " .. tostring(graphData.game or game.Name), 14)
    CreateLabel(GraphFrame, "Noeuds: " .. #nodes .. " | Relations: " .. tostring(graphData.relationCount or 0), 14)
    CreateLabel(GraphFrame, "Remotes modifiables: " .. remMod, 14)
    CreateLabel(GraphFrame, "Anti-cheats: " .. acCount, 14)
    CreateLabel(GraphFrame, "Score: " .. tostring(graphData.score or 0) .. "/100", 14)
    CreateLabel(GraphFrame, "Date: " .. tostring(graphData.date or "?"), 12)
    CreateLabel(GraphFrame, "-- Noeuds (50 premiers) --", 12, true)
    local maxShow = math.min(#nodes, 50)
    for i = 1, maxShow do
        local node = nodes[i]
        CreateLabel(GraphFrame, "[" .. node.type .. "] " .. tostring(node.label or ""):sub(1, 60), 12)
    end
    if #nodes > 50 then
        CreateLabel(GraphFrame, "... +" .. (#nodes - 50) .. " autres noeuds", 12)
    end
end

