-- SECTION 15 : RECHERCHE WEB VULNERABILITES
-- =========================================================================
local function SearchWeb(query)
    local results = {}
    local queries = {
        query .. " roblox exploit vulnerability",
        query .. " roblox script pastebin",
        query .. " roblox hack remote event"
    }
    for _, q in ipairs(queries) do
        if #results >= 10 then break end
        local url = "https://api.duckduckgo.com/?q=" .. HttpService:UrlEncode(q) .. "&format=json&no_html=1"
        local ok, resp = pcall(httpRequest, {Url = url, Method = "GET"})
        if ok and resp and resp.StatusCode == 200 then
            local decoded
            local decOk = pcall(function()
                decoded = HttpService:JSONDecode(resp.Body)
            end)
            if decOk and decoded then
                if decoded.AbstractText and #decoded.AbstractText > 0 then
                    table.insert(results, decoded.AbstractText)
                end
                if decoded.RelatedTopics then
                    for _, topic in ipairs(decoded.RelatedTopics) do
                        if type(topic) == "table" and topic.Text and #topic.Text > 0 then
                            table.insert(results, topic.Text)
                            if #results >= 10 then break end
                        end
                    end
                end
            end
        end
    end
    return results
end

