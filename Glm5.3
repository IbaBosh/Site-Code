-- SECTION 14 : API GLM 5.3
-- =========================================================================
local function CallGLM(prompt, apiKey)
    if #prompt > MAX_PROMPT_CHARS then
        prompt = string.sub(prompt, 1, MAX_PROMPT_CHARS) .. "\n...[Tronque]"
    end
    local body = HttpService:JSONEncode({
        model    = MODEL_NAME,
        messages = {{role = "user", content = prompt}},
        temperature = 1,
        top_p       = 1,
        max_tokens  = 16384,
        stream      = false
    })
    local headers = {
        ["Content-Type"]  = "application/json",
        ["Authorization"] = "Bearer " .. apiKey
    }
    for attempt = 1, MAX_RETRIES do
        if killed then return nil, "Killed" end
        local ok, resp = pcall(httpRequest, {
            Url     = API_URL,
            Method  = "POST",
            Headers = headers,
            Body    = body
        })
        if not ok or not resp then
            Log("GLM tentative " .. attempt .. " - reseau", Color3.fromRGB(255, 150, 50))
            task.wait(RETRY_DELAY)
        elseif resp.StatusCode == 429 then
            Log("GLM rate-limit, attente 15s", Color3.fromRGB(255, 200, 50))
            task.wait(15)
        elseif resp.StatusCode ~= 200 then
            Log("GLM HTTP " .. resp.StatusCode, Color3.fromRGB(255, 150, 50))
            task.wait(RETRY_DELAY)
        else
            local decoded
            local decOk = pcall(function()
                decoded = HttpService:JSONDecode(resp.Body)
            end)
            if decOk and decoded and decoded.choices and decoded.choices[1] then
                return decoded.choices[1].message.content
            end
            Log("GLM decodage echoue", Color3.fromRGB(255, 150, 50))
            task.wait(RETRY_DELAY)
        end
    end
    return nil, "Echec apres " .. MAX_RETRIES .. " tentatives"
end

