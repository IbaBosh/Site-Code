-- =========================================================================
local function FindMobs()
    local mobs = {}
    pcall(function()
        for _, v in pairs(Workspace:GetDescendants()) do
            if v:IsA("Humanoid") and v.Parent ~= char then
                local h = v.Parent:FindFirstChild("HumanoidRootPart")
                if h then
                    table.insert(mobs, {name = v.Parent.Name, hrp = h, humanoid = v, health = v.Health})
                end
            end
        end
    end)
    return mobs
end

local function FindNearestMob()
    char = player.Character
    local myHRP = char and char:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end
    local mobs = FindMobs()
    local nearest, nd = nil, math.huge
    for _, mob in ipairs(mobs) do
        local d = (mob.hrp.Position - myHRP.Position).Magnitude
        if d < nd and mob.humanoid.Health > 0 then
            nd      = d
            nearest = mob
        end
    end
    return nearest, nd
end

local function TeleportNear(targetHRP)
    char = player.Character
    local myHRP = char and char:FindFirstChild("HumanoidRootPart")
    if not myHRP or not targetHRP then return false end
    local targetCF = targetHRP.CFrame * CFrame.new(3, 0, 0)
    if antiCheatDetected then
        local tween = TweenService:Create(myHRP, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {CFrame = targetCF})
        tween:Play()
        tween.Completed:Wait()
    else
        myHRP.CFrame = targetCF
    end
    return true
end

local function KillAuraLoop()
    task.spawn(function()
        while running and not killed do
            local mob = FindNearestMob()
            if mob and mob.humanoid.Health > 0 then
                TeleportNear(mob.hrp)
                local hBefore = mob.humanoid.Health
                pcall(function()
                    local tool = char and char:FindFirstChildOfClass("Tool")
                    if tool then
                        tool:Activate()
                    else
                        VirtualInputManager:SendKeyEvent(true,  Enum.KeyCode.E, false, nil)
                        task.wait(0.03)
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, nil)
                    end
                end)
                task.wait(autoTuneDelay)
                local hAfter = mob.humanoid and mob.humanoid.Health or 0
                local dealt  = math.max(0, hBefore - hAfter)
                if dealt > 0 then
                    sessionStats.kills += 1
                    sessionStats.dps    = dealt / math.max(0.01, autoTuneDelay)
                    if dealt > 50 then
                        Log("DEGATS: " .. math.floor(dealt) .. " sur " .. mob.name, Color3.fromRGB(255, 200, 50))
                    end
                end
            else
                task.wait(0.5)
            end
        end
    end)
end

