-- SECTION 34 : STATS WATCHER (leaderstats delta > 100%)
-- =========================================================================
local function StartStatsWatcher()
    task.spawn(function()
        local leaderstats
        for _ = 1, 10 do
            leaderstats = player:FindFirstChild("leaderstats")
            if leaderstats then break end
            task.wait(1)
        end
        if not leaderstats then return end
        local snapshot = {}
        pcall(function()
            for _, v in pairs(leaderstats:GetChildren()) do
                if v:IsA("ValueBase") then
                    snapshot[v.Name] = tonumber(v.Value) or 0
                end
            end
        end)
        Log("Stats watcher actif sur leaderstats", Color3.fromRGB(3, 218, 198))
        while not killed do
            task.wait(2)
            pcall(function()
                for _, v in pairs(leaderstats:GetChildren()) do
                    if v:IsA("ValueBase") then
                        local current = tonumber(v.Value) or 0
                        local prev    = snapshot[v.Name]
                        if prev and prev ~= 0 then
                            local delta = math.abs(current - prev) / math.abs(prev)
                            if delta > 1.0 then
                                local msg = "STAT DELTA: " .. v.Name .. " " .. prev .. " -> " .. current
                                Log(msg, Color3.fromRGB(255, 200, 50))
                                ShowToast(msg, Color3.fromRGB(255, 200, 50))
                            end
                        end
                        snapshot[v.Name] = current
                    end
                end
            end)
        end
    end)
end

