local function DetectAntiCheat()
    local indicators = {}
    local keywords = {"anti","cheat","detect","check","ban","kick","speed","distance","teleport","exploit","flag","report"}
    local svcList  = {Workspace, ReplicatedStorage, ServerScriptService, ServerStorage}
    for _, svc in ipairs(svcList) do
        if svc then
            pcall(function()
                for _, v in pairs(svc:GetDescendants()) do
                    if v:IsA("ModuleScript") or v:IsA("Script") or v:IsA("LocalScript") then
                        local ln = v.Name:lower()
                        for _, kw in ipairs(keywords) do
                            if ln:find(kw, 1, true) then
                                table.insert(indicators, {name = v.Name, path = v:GetFullName(), keyword = kw})
                                break
                            end
                        end
                    end
                end
            end)
        end
    end
    antiCheatDetected = (#indicators > 0)
    if antiCheatDetected then
        Log("Anti-cheat detecte: " .. #indicators .. " indicateurs", Color3.fromRGB(255, 150, 50))
    else
        Log("Pas d'anti-cheat visible", Color3.fromRGB(75, 255, 75))
    end
    return indicators
end

