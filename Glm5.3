-- SECTION 23 : BUILD KNOWLEDGE GRAPH (MEGA GRAPHIQUE)
-- =========================================================================
local function BuildKnowledgeGraph(apiKey, userGoal)
    LogSection("DEBUT MEGA GRAPHIQUE", Color3.fromRGB(3, 218, 198))
    SetBar(5)

    LogSection("SCAN LOCAL", Color3.fromRGB(255, 175, 50))
    local scanData = ScanEnvironment()
    SetBar(25)

    LogSection("RECHERCHE WEB", Color3.fromRGB(255, 175, 50))
    local webIntel = SearchWeb(game.Name .. " " .. (userGoal or ""))
    Log("Web: " .. #webIntel .. " resultats", Color3.fromRGB(3, 218, 198))
    SetBar(45)

    LogSection("DETECTION ANTI-CHEAT", Color3.fromRGB(255, 175, 50))
    local antiCheats = DetectAntiCheat()
    SetBar(55)

    LogSection("REMOTE SPY PASSIF (10s)", Color3.fromRGB(255, 175, 50))
    local spyData = PassiveSpy(10)
    SetBar(75)

    LogSection("CONSTRUCTION DU GRAPHE", Color3.fromRGB(255, 175, 50))
    local nodes     = {}
    local relations = {}

    for _, item in ipairs(scanData) do
        if item.class == "RemoteEvent" or item.class == "RemoteFunction" then
            local ln          = item.name:lower()
            local isProtected = ln:find("ban") or ln:find("kick") or ln:find("admin") or ln:find("mod")
            table.insert(nodes, {
                type  = isProtected and "REMOTE_PROTEGE" or "REMOTE_MODIFIABLE",
                label = item.class .. ": " .. item.path,
                path  = item.path
            })
            if item.value then
                table.insert(relations, "REMOTE " .. item.path .. " -> VALUE " .. item.value)
            end
        elseif item.class == "ModuleScript" or item.class == "Script" or item.class == "LocalScript" then
            table.insert(nodes, {type = "SCRIPT", label = item.class .. ": " .. item.path, path = item.path})
        elseif item.value ~= nil then
            table.insert(nodes, {type = "VALUE",  label = item.name .. " = " .. item.value .. " | " .. item.path, path = item.path})
        end
    end

    for _, ac in ipairs(antiCheats) do
        table.insert(nodes,     {type = "ANTI_CHEAT", label = ac.name .. " | " .. ac.path, path = ac.path})
        table.insert(relations, "ANTICHEAT " .. ac.path .. " -> DANGER")
    end
    for _, wi in ipairs(webIntel) do
        table.insert(nodes,     {type = "WEB_INTEL", label = tostring(wi):sub(1, 80)})
        table.insert(relations, "WEB -> " .. tostring(wi):sub(1, 50))
    end
    for _, call in ipairs(spyData) do
        table.insert(nodes,     {type = "SPY_DATA", label = call.path .. " @" .. os.date("%H:%M:%S", call.time)})
        table.insert(relations, "SPY " .. call.path .. " -> ARGS_CAPTURED")
    end

    SetBar(90)
    local folderName = GetGameFolderName()
    currentGameFolder = MEMORY_BASE .. "/" .. folderName
    EnsureFolder(MEMORY_BASE)
    EnsureFolder(currentGameFolder)

    local graphData = {
        game          = game.Name,
        placeId       = game.PlaceId,
        nodes         = nodes,
        relations     = relations,
        relationCount = #relations,
        webIntel      = webIntel,
        antiCheats    = antiCheats,
        spyData       = spyData,
        scanCount     = #scanData,
        score         = math.min(100, math.floor(#nodes / 5) + #webIntel * 2),
        date          = os.date("%Y-%m-%d %H:%M:%S
        date          = os.date("%Y-%m-%d %H:%M:%S")
    }

    -- Sauvegarde principale + cloud backup horodate
    SaveJSON(currentGameFolder .. "/graph.json",        graphData)
    graphData.backupDate = os.date("%Y-%m-%d %H:%M:%S")
    SaveJSON(currentGameFolder .. "/graph_backup.json", graphData)
    SaveJSON(currentGameFolder .. "/scan_cache.json",   scanData)

    task.defer(function()
        UpdateGraphTab(graphData)
        RefreshGamesTab()
        RefreshScriptsTab()
    end)

    SetBar(100)
    graphBuilt = true
    LogSection("GRAPHIQUE TERMINE", Color3.fromRGB(3, 218, 198))
    Log("Noeuds: " .. #nodes .. " | Relations: " .. #relations .. " | Score: " .. graphData.score .. "/100", Color3.fromRGB(3, 218, 198))
    Log("Anti-cheats: " .. #antiCheats .. " | Spy: " .. #spyData .. " | Web: " .. #webIntel, Color3.fromRGB(3, 218, 198))
    return graphData
end

