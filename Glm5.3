local function ScanEnvironment()
    local scanData = {}
    local services = {
        {ReplicatedStorage, "ReplicatedStorage"},
        {StarterGui,        "StarterGui"},
        {StarterPlayer,     "StarterPlayer"},
        {Workspace,         "Workspace"},
    }
    if ServerStorage       then table.insert(services, {ServerStorage,       "ServerStorage"})       end
    if ServerScriptService then table.insert(services, {ServerScriptService, "ServerScriptService"}) end
    local pGui = player:FindFirstChildOfClass("PlayerGui")
    if pGui then table.insert(services, {pGui, "PlayerGui"}) end
    if char  then table.insert(services, {char, "Character"}) end
    local bp = player:FindFirstChildOfClass("Backpack")
    if bp then table.insert(services, {bp, "Backpack"}) end

    for _, entry in ipairs(services) do
        local svc = entry[1]
        if svc then
            pcall(function()
                for _, v in pairs(svc:GetDescendants()) do
                    local class = v.ClassName
                    if class == "RemoteEvent" or class == "RemoteFunction"
                    or class == "ModuleScript" or class == "LocalScript" or class == "Script"
                    or v:IsA("ValueBase") or class == "Tool" then
                        table.insert(scanData, {
                            class = class,
                            path  = v:GetFullName(),
                            name  = v.Name,
                            value = v:IsA("ValueBase") and tostring(v.Value) or nil
                        })
                    end
                end
            end)
        end
    end
    Log("Scan: " .. #scanData .. " objets", Color3.fromRGB(3, 218, 198))
    return scanData
end

