local function ServerHop()
    local placeId = game.PlaceId
    local url     = "https://games.roblox.com/v1/games/" .. placeId
        .. "/servers/Public?sortOrder=Asc&limit=100"
    Log("ServerHop: recherche serveurs...", Color3.fromRGB(255, 175, 50))
    local ok, resp = pcall(httpRequest, {Url = url, Method = "GET"})
    if not ok or not resp or resp.StatusCode ~= 200 then
        Log("ServerHop: liste inaccessible (HTTP " .. tostring(resp and resp.StatusCode or "?") .. ")", Color3.fromRGB(255, 75, 75))
        return
    end
    local decoded
    local decOk = pcall(function() decoded = HttpService:JSONDecode(resp.Body) end)
    if not decOk or not decoded or not decoded.data then
        Log("ServerHop: decodage echoue", Color3.fromRGB(255, 75, 75))
        return
    end
    local myJobId = game.JobId
    for _, server in ipairs(decoded.data) do
        if server.id ~= myJobId and server.playing < server.maxPlayers then
            Log("ServerHop -> " .. tostring(server.id):sub(1, 24) .. "...", Color3.fromRGB(3, 218, 198))
            pcall(function()
                TeleportService:TeleportToPlaceInstance(placeId, server.id, player)
            end)
            return
        end
    end
    Log("ServerHop: aucun serveur non-plein disponible", Color3.fromRGB(255, 150, 50))
end

ServerHopBtn.MouseButton1Click:Connect(function()
    task.spawn(ServerHop)
end)

