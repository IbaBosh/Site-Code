-- SECTION 18 : REMOTE SPY v2 (hookmetamethod __namecall unifie + fallback)
-- =========================================================================
local function SetupUnifiedNamecall()
    if oldNamecallUnified then return end
    if not (hookmetamethod and getnamecallmethod and newcclosure) then return end
    pcall(function()
        oldNamecallUnified = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            -- Spy v2 : capture passive si actif
            if remoteSpyActive then
                pcall(function()
                    if (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) and
                       (method == "FireServer" or method == "InvokeServer") then
                        table.insert(remoteCallsV2, {
                            path   = self:GetFullName(),
                            method = method,
                            args   = {...},
                            time   = os.time()
                        })
                    end
                end)
            end
            -- Anti-teleport force
            if self == TeleportService and
               (method == "Teleport" or method == "TeleportToPlaceInstance") then
                Log("TELEPORT SERVEUR BLOQUE", Color3.fromRGB(255, 75, 75))
                return nil
            end
            return oldNamecallUnified(self, ...)
        end))
        Log("Namecall hook: spy v2 + anti-teleport", Color3.fromRGB(75, 255, 75))
    end)
end

local function HookRemoteLegacy(remote)
    if hookedRemotesLegacy[remote] then return end
    hookedRemotesLegacy[remote] = true
    pcall(function()
        local path = remote:GetFullName()
        if remote:IsA("RemoteEvent") and hookfunction then
            local oldFire = remote.FireServer
            hookfunction(remote.FireServer, function(self, ...)
                if remoteSpyActive then
                    table.insert(remoteCallsV2, {path = path, method = "FireServer", args = {...}, time = os.time()})
                end
                return oldFire(self, ...)
            end)
        elseif remote:IsA("RemoteFunction") and hookfunction then
            local oldInvoke = remote.InvokeServer
            hookfunction(remote.InvokeServer, function(self, ...)
                if remoteSpyActive then
                    table.insert(remoteCallsV2, {path = path, method = "InvokeServer", args = {...}, time = os.time(), invoke = true})
                end
                return oldInvoke(self, ...)
            end)
        end
    end)
end

local function HookAllRemotes()
    pcall(function()
        for _, v in pairs(ReplicatedStorage:GetDescendants()) do
            if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
                HookRemoteLegacy(v)
            end
        end
    end)
end

local function PassiveSpy(duration)
    remoteCallsV2 = {}
    if not oldNamecallUnified then
        HookAllRemotes()
    end
    remoteSpyActive = true
    local elapsed = 0
    repeat
        task.wait(0.5)
        elapsed += 0.5
    until elapsed >= (duration or 10) or killed
    remoteSpyActive = false
    Log("Spy: " .. #remoteCallsV2 .. " remotes captures", Color3.fromRGB(3, 218, 198))
    return remoteCallsV2
end

