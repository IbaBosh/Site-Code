local function SaveJSON(path, data)
    pcall(function() writefile(path, HttpService:JSONEncode(data)) end)
end

local function LoadJSON(path)
    local ok, v = pcall(readfile, path)
    if ok and type(v) == "string" and #v > 0 then
        local ok2, decoded = pcall(HttpService.JSONDecode, HttpService, v)
        if ok2 then return decoded end
    end
    return nil
end

local function EnsureFolder(path)
    pcall(function()
        if not isfolder(path) then makefolder(path) end
    end)
end

local function SaveKey(k)
    if type(k) == "string" and #k > 8 then
        pcall(writefile, API_KEY_FILE, k)
    end
end

local function LoadKey()
    local ok, v = pcall(readfile, API_KEY_FILE)
    if ok and type(v) == "string" then
        local t = v:match("^%s*(.-)%s*$") or ""
        if #t > 8 then return t end
    end
    return nil
end

do
    local k = LoadKey()
    if k then
        KeyInput.Text = k
        Log("Cle API chargee", Color3.fromRGB(3, 218, 198))
    end
