local function ListScriptsInFolder(folderPath)
    local scripts = {}
    pcall(function()
        for _, f in ipairs(listfiles(folderPath)) do
            if f:match("%.lua$") then table.insert(scripts, f) end
        end
    end)
    return scripts
end

local function ShowContextMenu(scriptPath)
    if activeContextMenu then
        pcall(function() activeContextMenu:Destroy() end)
        activeContextMenu = nil
    end
    local cm = Instance.new("Frame")
    cm.Size             = UDim2.new(0, 190, 0, 165)
    cm.Position         = UDim2.new(0.5, -95, 0.5, -82)
    cm.BackgroundColor3 = Color3.fromRGB(22, 22, 33)
    cm.ZIndex           = 20
    cm.Parent           = NG
    Instance.new("UICorner", cm).CornerRadius = UDim.new(0, 8)
    local cmStroke = Instance.new("UIStroke")
    cmStroke.Color     = Color3.fromRGB(187, 134, 252)
    cmStroke.Thickness = 1
    cmStroke.Parent    = cm
    local fl = Instance.new("UIListLayout")
    fl.Padding = UDim.new(0, 2)
    fl.Parent  = cm
    activeContextMenu = cm

    local function CMBtn(label, bgCol, cb)
        local b = Instance.new("TextButton")
        b.Size             = UDim2.new(1, 0, 0, 30)
        b.BackgroundColor3 = bgCol or Color3.fromRGB(33, 33, 46)
        b.Font             = Enum.Font.Gotham
        b.Text             = label
        b.TextColor3       = Color3.fromRGB(220, 220, 220)
        b.TextSize         = 10
        b.ZIndex           = 21
        b.Parent           = cm
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 5)
        b.MouseButton1Click:Connect(function()
            pcall(function() cm:Destroy() end)
            activeContextMenu = nil
            cb()
        end)
    end

    local fname = scriptPath:match("([^/\\]+)$") or "script"

    CMBtn("Executer", Color3.fromRGB(28, 52, 28), function()
        local ok2, code = pcall(readfile, scriptPath)
        if ok2 and code then
            local fn, err = loadstring(code)
            if fn then
                task.spawn(function() pcall(fn) end)
                Log("Exec: " .. fname, Color3.fromRGB(75, 255, 75))
            else
                Log("Syntaxe: " .. tostring(err):sub(1, 70), Color3.fromRGB(255, 75, 75))
            end
        end
    end)
    CMBtn("Copier code", Color3.fromRGB(22, 28, 52), function()
        local ok2, code = pcall(readfile, scriptPath)
        if ok2 and code then
            pcall(setclipboard, code)
            Log("Code copie", Color3.fromRGB(3, 218, 198))
        end
    end)
    CMBtn("Voir dans logs", Color3.fromRGB(33, 33, 46), function()
        local ok2, code = pcall(readfile, scriptPath)
        if ok2 and code then
            LogSection("CODE: " .. fname, Color3.fromRGB(255, 200, 50))
            for line in code:gmatch("[^\n]+") do
                Log("  " .. line, Color3.fromRGB(145, 200, 255))
            end
        end
    end)
    CMBtn("Hot reload (activer)", Color3.fromRGB(22, 38, 52), function()
        hotReloadPath = scriptPath
        Log("Hot reload: " .. fname .. " defini", Color3.fromRGB(80, 180, 255))
    end)
    CMBtn("Supprimer", Color3.fromRGB(52, 18, 18), function()
        pcall(delfile, scriptPath)
        Log("Supprime: " .. fname, Color3.fromRGB(255, 100, 100))
        task.defer(RefreshScriptsTab)
    end)

    task.delay(8, function()
        if activeContextMenu == cm then
            pcall(function() cm:Destroy() end)
            activeContextMenu = nil
        end
    end)
end

