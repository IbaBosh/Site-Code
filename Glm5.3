-- SECTION 22 : ANTI-KICK / ANTI-TELEPORT -- CORRIGE: pattern oldNamecall propre
-- =========================================================================
local function SetupAntiKick()
    if antiKickSetup then return end
    antiKickSetup = true
    -- Block player:Kick() via __index metatable
    pcall(function()
        local mt = getrawmetatable and getrawmetatable(player) or nil
        if mt and setreadonly and newcclosure then
            setreadonly(mt, false)
            local oldIndex = mt.__index
            mt.__index = newcclosure(function(self, k)
                if k == "Kick" then
                    return function(self2, reason)
                        Log("KICK BLOQUE: " .. tostring(reason or ""), Color3.fromRGB(255, 75, 75))
                    end
                end
                if type(oldIndex) == "function" then return oldIndex(self, k)
                elseif type(oldIndex) == "table"    then return oldIndex[k] end
                return nil
            end)
            setreadonly(mt, true)
        end
    end)
    -- Namecall unifie (anti-teleport + spy v2)
    SetupUnifiedNamecall()
    Log("Anti-kick actif", Color3.fromRGB(75, 255, 75))
end

