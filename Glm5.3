local function ListGameFolders()
    local folders = {}
    pcall(function()
        if isfolder(MEMORY_BASE) then
            for _, f in ipairs(listfiles(MEMORY_BASE)) do
                if isfolder(f) then
                    local name = f:match("nexus_games[/\\]([^/\\]+)$")
                    if name then table.insert(folders, name) end
                end
            end
        end
    end)
    return folders
end

