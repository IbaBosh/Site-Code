local function HotReload()
    if not hotReloadPath then
        Log("HotReload: aucun script defini. Utilise '...' > Hot reload dans SCRIPTS.", Color3.fromRGB(255, 150, 50))
        return
    end
    local ok, code = pcall(readfile, hotReloadPath)
    if not ok or not code or #code == 0 then
        Log("HotReload: lecture impossible - " .. tostring(hotReloadPath), Color3.fromRGB(255, 75, 75))
        return
    end
    local fname = hotReloadPath:match("([^/\\]+)$") or hotReloadPath
    Log("HotReload: rechargement de " .. fname, Color3.fromRGB(80, 180, 255))
    local fn, err = loadstring(code)
    if not fn then
        Log("HotReload syntaxe: " .. tostring(err):sub(1, 80), Color3.fromRGB(255, 75, 75))
        return
    end
    task.spawn(function() pcall(fn) end)
    Log("HotReload OK", Color3.fromRGB(75, 255, 75))
    ShowToast("HotReload: " .. fname, Color3.fromRGB(80, 180, 255))
end

