-- SECTION 33 : TOAST NOTIFICATIONS (3s, slide in/out)
-- =========================================================================
local function ShowToast(msg, col)
    local toast = Instance.new("Frame")
    toast.Size             = UDim2.new(0, 340, 0, 42)
    toast.Position         = UDim2.new(0.5, -170, 0, -50)
    toast.BackgroundColor3 = Color3.fromRGB(22, 22, 33)
    toast.ZIndex           = 30
    toast.Parent           = NG
    Instance.new("UICorner", toast).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke")
    stroke.Color     = col or Color3.fromRGB(187, 134, 252)
    stroke.Thickness = 1
    stroke.Parent    = toast
    local lbl = Instance.new("TextLabel")
    lbl.Size                   = UDim2.new(1, -16, 1, 0)
    lbl.Position               = UDim2.new(0, 8, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font                   = Enum.Font.GothamBold
    lbl.Text                   = tostring(msg)
    lbl.TextColor3             = col or Color3.fromRGB(220, 220, 220)
    lbl.TextSize               = 11
    lbl.TextWrapped            = true
    lbl.ZIndex                 = 31
    lbl.Parent                 = toast
    TweenService:Create(
        toast,
        TweenInfo.new(0.3, Enum.EasingStyle.Quad),
        {Position = UDim2.new(0.5, -170, 0, 10)}
    ):Play()
    task.delay(3, function()
        TweenService:Create(
            toast,
            TweenInfo.new(0.3, Enum.EasingStyle.Quad),
            {Position = UDim2.new(0.5, -170, 0, -55)}
        ):Play()
        task.delay(0.4, function()
            pcall(function() toast:Destroy() end)
        end)
    end)
end

