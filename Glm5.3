-- =========================================================================
-- SECTION 25 : EXECUTION DE CODE -- CORRIGE: print restaure dans tous les cas
-- =========================================================================
local function ExecuteCode(code)
    local outputs = {}
    local fn, loadErr = loadstring(code)
    local ok, runErr
    if fn then
        local _print = print
        print = function(...)
            local parts = {}
            for i = 1, select("#", ...) do
                parts[i] = tostring(select(i, ...))
            end
            table.insert(outputs, table.concat(parts, "  "))
            _print(...)
        end
        ok, runErr = pcall(fn)
        print = _print -- restauration garantie apres pcall (pcall absorbe l'erreur)
    else
        ok, runErr = false, "loadstring: " .. tostring(loadErr)
    end
    return ok, runErr, outputs
end

